# Copy to .env and adjust. Never commit .env.
DATABASE_URL=sqlite:///./outreach.db
# DATABASE_URL=postgresql+psycopg2://outreach:outreach@localhost:5432/outreach

# mock | twilio
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

SEED_DEMO_DATA=true

# Line health policy
HEALTH_REST_THRESHOLD=70
HEALTH_QUARANTINE_THRESHOLD=50
REST_HOURS=48
DEFAULT_DAILY_SMS_CAP=150

# Email warm-up
WARMUP_START_VOLUME=5
WARMUP_TARGET_VOLUME=40
WARMUP_DAYS=28
