# Copy to .env and adjust. Never commit .env.
DATABASE_URL=sqlite:///./outreach.db
# DATABASE_URL=postgresql+psycopg2://outreach:outreach@localhost:5432/outreach

# --- Providers ---
# mock | twilio
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# mock | smtp
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: hand email sending to Instantly
INSTANTLY_API_KEY=

# --- Security / identity ---
SECRET_KEY=change-me-to-a-long-random-string   # signs unsubscribe links
WEBHOOK_SECRET=                                # required header X-Webhook-Secret on /webhooks/email/inbound
PUBLIC_BASE_URL=http://localhost:8000          # used to build unsubscribe links
COMPANY_NAME=Acme Homes LLC
COMPANY_ADDRESS=1200 Main St, Suite 400, Dallas, TX 75201

SEED_DEMO_DATA=true
ENABLE_SCHEDULER=true

# --- Compliance ---
QUIET_HOURS_END=8
QUIET_HOURS_START=21
MAX_TOUCHES_PER_24H=3

# --- Pacing ---
SEND_JITTER_MINUTES=120
SMS_MIN_GAP_SECONDS=20
EMAIL_MIN_GAP_MINUTES=6
EMAIL_SEND_START=8
EMAIL_SEND_END=18

# --- Line health ---
HEALTH_REST_THRESHOLD=70
HEALTH_QUARANTINE_THRESHOLD=50
REST_HOURS=48
DEFAULT_DAILY_SMS_CAP=150
DEFAULT_DAILY_CALL_CAP=100

# --- Email warm-up & domains ---
WARMUP_START_VOLUME=5
WARMUP_TARGET_VOLUME=40
WARMUP_DAYS=28
COLD_START_DAY=14
MAX_BOUNCE_RATE=0.03
MAX_COMPLAINT_RATE=0.001
DOMAIN_MAX_BOUNCE_RATE=0.05
